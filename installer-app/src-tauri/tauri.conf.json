{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoSim Setup",
  "version": "1.0.0",
  "identifier": "com.mosim.setup",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MoSim Setup",
        "width": 720,
        "height": 480,
        "resizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src 'self' https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
